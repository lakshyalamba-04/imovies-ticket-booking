{
  "name": "imovies-movie-ticket-booking",
  "version": "1.0.0",
  "description": "IMovies - Movie ticket booking made simple. Full Stack MERN Application",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "node server/data/seedData.js"
  },
  "keywords": [
    "mern",
    "movie-ticket-booking",
    "imovies",
    "react",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "IMovies Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "qrcode": "^1.5.4"
  }
}
